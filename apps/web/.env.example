# Server-only Python API URL. Never use a NEXT_PUBLIC_ prefix for this value.
API_BASE_URL=http://127.0.0.1:8000
# Server-only secret; use the same value as Python's API_SHARED_SECRET.
# Leave empty only when the development Python service has authentication disabled.
API_SHARED_SECRET=
# On Railway, set this to the public HTTPS website origin (no path).
# WEB_ORIGIN=https://your-website.up.railway.app
