{
  "name": "@monobosses/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests scripts/check-python-api.ts scripts/check-evidence-api.ts next.config.ts package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check app components lib tests scripts/check-python-api.ts scripts/check-evidence-api.ts next.config.ts package.json tsconfig.json .prettierrc.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node --experimental-strip-types scripts/check-python-api.ts",
    "test:evidence-api": "node --experimental-strip-types scripts/check-evidence-api.ts",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
