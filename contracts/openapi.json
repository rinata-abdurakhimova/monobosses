              "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "title": "Claim Ids",
            "type": "array"
          },
          "key": {
            "$ref": "#/components/schemas/SectionKey"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "structured_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Structured Data"
          },
          "summary": {
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "key",
          "summary"
        ],
        "title": "SectionContent",
        "type": "object"
      },
      "SectionKey": {
        "enum": [
          "recommendation",
          "scientific_thesis",
          "human_translation_thesis",
          "clinical_development_plan",
          "competitive_landscape",
          "commercial_opportunity",
          "capital_to_milestone",
          "key_risks",
          "critical_unknowns",
          "diligence_questions",
          "sources"
        ],
        "title": "SectionKey",
        "type": "string"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "content_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Content Hash",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "enum": [
              "peer_reviewed",
              "preprint",
              "registry",
              "regulatory",
              "company",
              "patent",
              "database",
              "user_upload",
              "synthetic"
            ],
            "title": "Type",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "retrieved_at",
          "content_hash",
          "synthetic"
        ],
        "title": "Source",
        "type": "object"
      },
      "SupportStatus": {
        "enum": [
          "supported",
          "contradicted",
          "mixed",
          "unverified",
          "unknown"
        ],
        "title": "SupportStatus",
        "type": "string"
      },
      "Usage": {
        "additionalProperties": false,
        "properties": {
          "calls": {
            "default": 0,
