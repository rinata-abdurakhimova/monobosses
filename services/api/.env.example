# Copy to .env for local work. NEVER commit a real .env or real keys.
APP_ENV=development
HOST=127.0.0.1
PORT=8000

LLM_PROVIDER=placeholder
LLM_MODEL=placeholder-model
LLM_API_KEY=your-key-here
# Mentor gateway (set LLM_PROVIDER=openai, LLM_MODEL=gpt-6-luna,
# and LLM_API_KEY to your team key; NOT API_SHARED_SECRET):
# LLM_BASE_URL=https://secrethon-gateway.nicewave-ab4e0867.swedencentral.azurecontainerapps.io/v1
LLM_MAX_RETRIES=2
LLM_MAX_REPAIRS=1
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096
CLINICAL_REASONING_EFFORT=low
MARKET_REASONING_EFFORT=low
NODE_REQUEST_MAX_BYTES=15500
# false sends oversized general-node requests to the gateway for this test.
ENFORCE_NODE_REQUEST_BUDGET=false
SCIENCE_REQUEST_TARGET_BYTES=10000
RETRIEVAL_PUBMED_PER_QUERY=3
RETRIEVAL_TRIALS_PER_QUERY=4
NODE_INITIAL_REQUEST_BYTES=13500
NODE_REASONING_EFFORT=low
# Fill ALL THREE only after checking the provider's current prices; otherwise cost is "unavailable":
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=
# LLM_PRICE_DATE=

DATABASE_URL=sqlite:///./data/vic.sqlite3
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
# MAX_RUN_COST_USD=
MAX_RUN_SECONDS=600
MAX_CONCURRENT_RUNS=2

# Required in production (the Next.js server sends it as the X-API-Key header)
API_SHARED_SECRET=change-me

# Local development without real agents/model: synthetic stub mode (NEVER in production)
RUN_BACKEND=pipeline
DEV_STUBS=true
STUB_DELAY_SECONDS=1
SEED_SYNTHETIC=true

# Partial synthetic mode: real R4/R5-market agents + real model; stub only what does not exist yet
# DEV_STUBS=true
# STUB_MODULES=build_evidence_pack,audit_claims,analyze_investment,synthesize_committee

# Small external retrieval sample for gateways with tight input limits.
RETRIEVAL_PUBMED_RETMAX=1
RETRIEVAL_TRIALS_PAGE_SIZE=1
RETRIEVAL_MAX_EXTERNAL_DOCUMENTS=2
RETRIEVAL_EXCERPT_MAX_BYTES=500

# Clinical sends full scoped inputs; the provider determines its input limit.

# Default: send full LLM inputs; provider controls limits. Set false for bounded mode.
PROVIDER_INPUT_LIMIT_TEST=true

# Keep rejected specialist analyses visible as unavailable and continue to Chair.
CONTINUE_ON_NODE_VALIDATION_ERROR=true
